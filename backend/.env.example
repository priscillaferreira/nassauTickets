# Copie este arquivo para ".env" e ajuste se necessário.
# Porta da API
PORT=3001
# Horário do expediente (horas inteiras, 24h)
EXPEDIENTE_INICIO=7
EXPEDIENTE_FIM=17
# true = permite testar fora do horário 7h-17h (use false em produção)
IGNORAR_EXPEDIENTE=true
# Origem permitida para o frontend (CORS)
CORS_ORIGEM=http://localhost:5173
